        <path><!-- inserted at build time --></path>
      </met>
      <poolinitcond>
        <path><!-- inserted at build time --></path>
      </poolinitcond>
      <events>
        <path><!-- inserted at build time --></path>
      </events>
    </inputs>
    <start.date><!-- inserted at build time --></start.date>
    <end.date><!-- inserted at build time --></end.date>
  </run>
</pecan>
