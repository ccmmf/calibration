  <ensemble>
    <size>1</size>
    <variable>TotSoilCarb</variable>
    <variable>soil_carbon_content</variable>
    <variable>litter_carbon_content</variable>
    <variable>N2O_flux</variable>
    <variable>CH4_flux</variable>
    <variable>NEE</variable>
    <variable>NPP</variable>
    <variable>HeteroResp</variable>
    <variable>AbvGrndWood</variable>
    <variable>SoilMoistFrac</variable>
    <samplingspace>
      <parameters>
        <method>uniform</method>
      </parameters>
      <met>
        <method>sampling</method>
      </met>
      <poolinitcond>
        <method>sampling</method>
      </poolinitcond>
      <events>
        <method>sampling</method>
      </events>
    </samplingspace>
    <start.year><!-- inserted at build time --></start.year>
    <end.year><!-- inserted at build time --></end.year>
  </ensemble>
  <model>
    <id>99000000003</id>
    <type>SIPNET</type>
    <revision>2.2.0</revision>
    <delete.raw>FALSE</delete.raw>
    <binary><!-- replaced at build time -->./sipnet</binary>
    <default.param><!-- replaced at build time -->sipnet.default.param</default.param>
    <options>
      <GDD>0</GDD>
      <NITROGEN_CYCLE>1</NITROGEN_CYCLE>
      <ANAEROBIC>1</ANAEROBIC>
      <FLOODING>1</FLOODING>
      <LITTER_POOL>1</LITTER_POOL>
    </options>
  </model>
  <host>
    <name>localhost</name>
    <outdir><!-- replaced at build time -->output/out</outdir>
    <rundir><!-- replaced at build time -->output/run</rundir>
    <qsub>qsub -V -cwd -N @NAME@ -j y -o /dev/null -S /bin/bash</qsub>
    <qsub.jobid>Your job-array ([0-9]+).*</qsub.jobid>
    <qstat>qstat -j @JOBID@ || echo DONE</qstat>
    <modellauncher>
      <binary>./scripts/sge_array_launcher.sh</binary>
      <qsub.extra>-t 1-@NJOBS@</qsub.extra>
      <Njobmax>140</Njobmax>
    </modellauncher>
    <!-- job.sh calls model2netcdf.SIPNET, so R must be on the path in the job -->
    <prerun>module load R/4.4.3</prerun>
  </host>
  <outdir><!-- replaced at build time -->output</outdir>
  <modeloutdir><!-- replaced at build time -->output/out</modeloutdir>
  <rundir><!-- replaced at build time -->output/run</rundir>
  <run>
    <site><!-- inserted at build time --></site>
    <inputs>
      <pft.site>
        <path><!-- inserted at build time -->site_pft.csv</path>
      </pft.site>
