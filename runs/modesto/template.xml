<?xml version="1.0"?>
<!-- Modesto template. Identical to runs/template.xml except for the PFT, which is
     temperate.deciduous here and annual_crop there. Every other setting is held
     constant across the six runs.
     magic-ensemble replaces <model> and <host> wholesale at prepare time from
     workflow/workflow_manifest.yaml, so the blocks below record the intended
     settings rather than the ones SIPNET currently receives. See "Known gaps". -->
<pecan>
 <info>
  <notes></notes>
  <userid>-1</userid>
  <username></username>
 </info>
 <outdir>output</outdir>
 <modeloutdir>output/out</modeloutdir>
 <rundir>output/run</rundir>
 <pfts>
  <pft>
   <name>temperate.deciduous</name>
   <posterior.files>pfts/temperate.deciduous/post.distns.Rdata</posterior.files>
  </pft>
 </pfts>
 <ensemble>
  <size><!-- inserted at config time --></size>
  <variable>NPP</variable>
  <variable>TotSoilCarb</variable>
  <variable>AbvGrndWood</variable>
  <variable>Qle</variable>
  <variable>SoilMoistFrac</variable>
  <samplingspace>
   <parameters>
    <method>uniform</method>
   </parameters>
   <met>
    <method>sampling</method>
   </met>
   <poolinitcond>
    <method>sampling</method>
   </poolinitcond>
   <!-- TODO soil init cond here when ready -->
  </samplingspace>
  <start.year><!-- inserted at config time --></start.year>
  <end.year><!-- inserted at config time --></end.year>
 </ensemble>
 <model>
  <id>99000000003</id>
  <type>SIPNET</type>
  <revision>v2.2.0-alpha.1</revision>
  <delete.raw>TRUE</delete.raw>
  <binary>sipnet</binary>
  <options>
   <GDD>0</GDD>
   <NITROGEN_CYCLE>1</NITROGEN_CYCLE>
   <ANAEROBIC>1</ANAEROBIC>
   <LITTER_POOL>1</LITTER_POOL>
  </options>
  <prerun>cp data/events.in @RUNDIR@</prerun>
 </model>
 <run>
  <site><!-- inserted at config time --></site>
  <inputs>
   <met>
    <id></id>
    <path><!-- inserted at config time --></path>
   </met>
   <poolinitcond>
     <source>RS_veg</source>
     <output>poolinitcond</output>
     <ensemble><!-- inserted at config time --></ensemble>
     <path><!-- inserted at config time --></path>
   </poolinitcond>
  </inputs>
  <start.date><!-- inserted at config time --></start.date>
  <end.date><!-- inserted at config time --></end.date>
 </run>
 <host>
  <name>localhost</name>
  <qsub>sbatch -J @NAME@ -o @STDOUT@ -e @STDERR@ @PARTITION@</qsub>
  <qsub.jobid>Submitted batch job ([0-9]+)</qsub.jobid>
  <qstat>if test -z "$(squeue -h -j @JOBID@)"; then echo "DONE"; fi</qstat>
  <outdir>output/out</outdir>
  <rundir>output/run</rundir>
 </host>
</pecan>
