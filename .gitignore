# build artifacts
*.tar.gz
/*.Rcheck/

# run outputs and artifacts, regenerated by the scripts
/cache/
/figures/

# runs/ holds versioned per-site run configs; run outputs under each are ignored
/runs/*
# the combined site_info.csv, the shared template.xml and any docs live
# directly under runs/
!/runs/*.csv
!/runs/*.xml
!/runs/README.md
!/runs/*/
/runs/*/*
!/runs/*/*.yml
!/runs/*/*.yaml
!/runs/*/*.csv
!/runs/*/*.xml
!/runs/*/*.json
!/runs/*/README.md
# per-treatment event sets live one level deeper
!/runs/*/*/
!/runs/*/*/*.json
!/runs/*/*/README.md

# r session files
.Rhistory
.RData
.Rproj.user/

# rendered reports, regenerated from the qmd
examples/*/report.html
examples/*/report_files/
reports/*.html
reports/*_files/

# quarto site, built by quarto render / quarto publish
/_site/
/.quarto/

# local agent instructions
/AGENTS.md
/r_coding_preferences.md

# desktop and language-session artifacts
.DS_Store
__pycache__/
*.pyc
.venv/

# local ad-hoc analyses
/analysis/

