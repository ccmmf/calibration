# build artifacts
*.tar.gz
/*.Rcheck/

# run outputs and artifacts, regenerated by the scripts
/cache/
/figures/

# runs/ holds versioned per-site run configs; run outputs under each are ignored
/runs/*
!/runs/*/
/runs/*/*
!/runs/*/*.yml
!/runs/*/*.yaml
!/runs/*/*.csv
!/runs/*/*.xml
!/runs/*/*.json
!/runs/*/README.md

# r session files
.Rhistory
.RData
.Rproj.user/
